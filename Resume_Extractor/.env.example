# Application Settings
APP_NAME="Resume Extractor"
APP_ENV=development
DEBUG=true
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8000

# Security & CORS
SECRET_KEY=change-this-super-secret-key-in-production
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:8000"]

# AI Model API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# NLP & OCR Configuration
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\Program Files\poppler\Library\bin
SPACY_MODEL=en_core_web_sm

# File Storage Configuration
UPLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=resume_extractor
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resume_extractor

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log
