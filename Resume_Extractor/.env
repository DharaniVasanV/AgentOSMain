# Application Settings
APP_NAME="Resume Extractor"
APP_ENV=development
DEBUG=true
API_V1_STR="/api/v1"
HOST=127.0.0.1
PORT=8008

# Security & CORS
SECRET_KEY=change-this-super-secret-key-in-production
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:8001"]

# AI Model API Configuration
# Groq (primary — free 14k req/day, get key at console.groq.com)
GROQ_API_KEY=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
GROQ_MODEL=llama-3.1-8b-instant
# Gemini (secondary fallback)
# OpenAI (tertiary fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# NLP & OCR Configuration
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=C:\Program Files\poppler\Library\bin
SPACY_MODEL=en_core_web_sm

# File Storage Configuration
UPLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=resume_extractor
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/resume_extractor

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log
